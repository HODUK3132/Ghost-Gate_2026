  lines:
  - speaker: "\uBB34\uB2F9"
    text: "\uB204\uAD6C\uC2DC\uC624?"
  - speaker: "\uB098"
    text: "\uC800 \uC0AC\uB2F9\uC73C\uB85C \uAC00\uB294 \uAE38\uC744 \uC544\uC2DC\uC624?"
  - speaker: "\uBB34\uB2F9"
    text: "\uC800 \uC55E\uCABD \uC6B0\uBB3C\uAE38\uC744 \uC9C0\uB098\uBA74 \uB418\uB294\uB370.. "
  - speaker: "\uBB34\uB2F9"
    text: "\uB300\uC2E0 \uC704\uD5D8\uD558\uC5EC \uB0B4\uAC00 \uB3C4\uC640\uC8FC\uACA0\uC18C.\n\uB2E4\uB9CC
