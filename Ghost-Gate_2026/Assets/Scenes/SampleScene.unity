  - speaker: "\uB098"
    text: "\uC54C\uACA0\uC18C.\n\uBB34\uC5C7\uC744 \uB3C4\uC640\uB4DC\uB9AC\uBA74
      \uB418\uACA0\uC18C?"
  - speaker: "\uBB34\uB2F9"
    text: "\uC77C\uB2E8 \uC9D1 \uC548\uC73C\uB85C \uB4E4\uC5B4\uC624\uACA0\uB098?"
